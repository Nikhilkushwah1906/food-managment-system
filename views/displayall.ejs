<style>
    
  * {
    margin: 0px;
    padding: 0px;
  }

  .root {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 98%;
    height: 98%;
    font-family: Roboto;
  }

  .box {
    border: 0.5px solid gray;
    border-radius: 10px;
    background-color: whitesmoke;
    width: 1100px;
    height: auto;
  }

  .heading {
   
    margin: 4px;
    display: flex;
    justify-content: center;
    flex-direction: row;
    align-items: center;
  }

  .headingStyle {
    font-size: 24px;
    font-weight: 800px;
    color: #d63031;
    margin-left: 15px;
  }

  .formdiv {
    margin-top: 20px;
    width: 100%;
    height: 500px;
  }

  .centeralign {
    display: flex;
    justify-content: center;
    align-items: center;
  }
</style>


<html>
    <head>
        <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="/javascripts/project.js"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Kanit:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
      rel="stylesheet"
    />
    </head>

    <body>
        <div class="root">
            <div class="box">
              <div class="heading">
                <img src="/images/logo.png" alt="logo" width="150px" height="90px" />
                <div class="headingStyle">List Of Foods</div>
              </div>
              
              <div>
                <table class="table">
                    <thead class="thead-dark">
                      <tr>
                        <th scope="col">#</th>
                        <th scope="col">Food Name</th>
                        <th scope="col">Food Price</th>
                        <th scope="col">Food Offer Price</th>
                        <th scope="col">Food Type</th>
                        <th scope="col">Food Status</th>
                        <th scope="col">Food Ingredients</th>
                        <th scope="col">Food Picture</th>
                        <th scope="col">Edit/Delete</th>
                      </tr>
                    </thead>

                    <tbody>
                        <% data.map((item,i)=>{ %>
                        <tr scope="row">
                            <td><%=i+1 %></td>
                            <td><%=item.food_name %> </td>
                            <td><%=item.food_price %> </td>
                            <td><%=item.food_offerprice %> </td>
                            <td><%=item.food_type %> </td>
                            <td><%=item.food_status %></td>
                            <td><%=item.food_ingredients %></td>
                            <td><a href="/food/display_for_picture_edit?food_id=<%=item.food_id%>&foodname=<%=item.food_name%>&fdpicture=<%=item.food_picture%> " style="text-decoration: none;"><img src="/images/<%=item.food_picture %>" alt="Food_Picture" width="130px" height="90"></a></td>
                            <td><a href="/food/display_for_edit?food_id=<%=item.food_id%>" style="text-decoration: none;">Edit/Delete</a></td>
                        </tr>
                        <% }) %>
                    </tbody>

                  </table>
              </div>
            </div>
        </div>    
    </body>
</html>