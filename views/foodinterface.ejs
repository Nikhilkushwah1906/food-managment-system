<style>
    
    @import url('https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap');

    * {
        margin: 0px;
        padding: 0px;
      }
    
      .root {
        display: flex;
        justify-content: center;
        align-items: center;
        background: white;
        width: 100%;
        height: 85%;
        font-family: Roboto;
      }
    
      .box {
        border: 0.5px solid gray;
        border-radius: 10px;
        background-color: whitesmoke;
        width: 900px;
        height: 600px;
      }

      .heading {
        
        margin: 4px;
        display: flex;
        justify-content: center;
        flex-direction: row;
        align-items: center;
      }
    
      .headingStyle {
        font-size: 24px;
        font-weight: 800px;
        color: #d63031;
        margin-left: 15px;
      }

      .formdiv {
        margin-top: 20px;
        width: 100%;
        height: 500px;
      }
    
      .centeralign {
        display: flex;
        justify-content: center;
        align-items: center;
      }
</style>

<html>
    <head>
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

            <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
            <script src="/javascripts/project.js"></script>
    </head>

<form action="/food/submit_food" method="post" enctype="multipart/form-data">

    <div class="root">
        <div class="box">
                <div class="heading">
                    <img src="/images/logo.png" alt="logo" width="150px" height="90px" />
                    <div class="headingStyle">Food Registration System</div>
                </div>
                <hr color="red" size="5px">

                <div class="container formdiv">
                    <div class="row" style="margin-bottom: 20px">
                      <div class="col-sm-4">
                        <select name="food_category" id="foodcategory" class="form-control">
                            <option align="center">- Food Category -</option>
                        </select>
                      </div>
                      <div class="col-sm-4">
                        <select name="food_subcategory" id="foodsubcategory" class="form-control">
                            <option align="center">- Food SubCategory -</option>
                        </select>
                      </div>
                      <div class="col-sm-4">
                        <input
                        type="text"
                        name="foodname"
                        id="foodname"
                        class="form-control"
                        placeholder="Food Name"
                      />
                      </div>
                    </div>

                    <div class="row" style="margin-bottom: 25px" align="center">
                        <div class="col-sm-3" >
                            <h5><label class="form-label">Price</label></h5>
                            <input
                              type="text"
                              name="price"
                              class="form-control"
                              placeholder="Rs" />
                        </div>
                        <div class="col-sm-3" >
                            <h5><label class="form-label">Offer Price</label></h5>
                            <input
                              type="text"
                              name="offerprice"
                              class="form-control"
                              placeholder="Rs"
                            />
                        </div>

                        <div class="col-sm-3" >
                            <h5> <div>Food Type</div></h5>
                             <div class="form-check form-check-inline">
                               <input
                                 class="form-check-input"
                                 type="radio"
                                 id="foodtype"
                                 name="foodtype"
                                 value="Vegetarian"
                               />Veg
                             </div>
                             <div class="form-check form-check-inline">
                                 <input
                                   class="form-check-input"
                                   type="radio"
                                   id="foodtype"
                                   name="foodtype"
                                   value="Non-Vegetarian"
                                 />Non-Veg
                               </div>
                         </div>

                         <div class="col-sm-3" >
                            <h5><div>Food Status</div></h5>
                            <div class="form-check form-check-inline">
                              <input
                                class="form-check-input"
                                type="radio"
                                name="foodstatus"
                                id="foodstatus"
                                value="Available"
                              />Avail
                            </div>
                            <div class="form-check form-check-inline">
                                <input
                                  class="form-check-input"
                                  type="radio"
                                  id="foodstatus"
                                  name="foodstatus"
                                  value="Not-Available"
                                />Not-Avail
                              </div>
                        </div>
                         
                    </div>

                    <div class="row" style="margin-bottom: 25px" align="center">
                        <div class="col-sm-6">
                            <h5>Food Ingredients </h5>
                        </div>
                        <div class="col-sm-6" >
                          <textarea id="foodingredient" name="foodingredient" rows="3" cols="40" placeholder="Wrtie Ingredients Here........."></textarea>
                        </div>
                    </div>   
                    
                    <div class="row" style="margin-bottom: 20px">
                        <div class="col-sm-6" >
                          <label for="formFile" class="form-label">Upload Food Image</label>
                          <input
                            class="form-control"
                            type="file"
                            name="foodlogo"
                            id="foodlogo"
                            onchange="showPicture()"
                          />
                        </div>
                        <div
                          class="col-sm-6 centeralign"
                        >
                          <img
                            src="/images/food.png"
                            alt="food"
                            id="foodpic"
                            name="foodpic"
                            style="height: 70px; width: 70px; border-radius :10px "
                          />
                        </div>
                      </div><hr color="red" size="5px">


                      <div class="row" style="margin-bottom: 10px">
                        <div class="col-sm-6 centeralign">
                          <button type="submit" class="btn btn-primary">Submit</button>
                        </div>
                        <div class="col-sm-6 centeralign">
                          <button type="reset" class="btn btn-primary">Reset</button>
                        </div>
                      </div>
                      
                      <div class="row" style="margin-bottom: 7px">
                        <div class="col-sm-12 centeralign">
                          <%=Message %>
                        </div>
                      </div>     
              


                </div>    
        </div>
    </div>

</form>


</html>